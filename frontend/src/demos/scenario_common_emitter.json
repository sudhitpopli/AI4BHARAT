  "physics_links": [],
  "controls": [
    {
      "group": "Signal",
      "label": "Input Frequency",
      "param": "vin.ac_frequency",
      "min": 100,
      "max": 100000,
      "default": 1000,
      "step": 100,
      "unit": "Hz",
      "education_note": "At low frequencies, Cin and Ce impede signal flow, reducing gain. At high frequencies, Cπ and Cμ roll off gain."
    },
    {
      "group": "Signal",
      "label": "Input Amplitude",
      "param": "vin.ac_amplitude",
      "min": 0.001,
      "max": 0.1,
      "default": 0.01,
      "step": 0.001,
      "unit": "V",
      "education_note": "Keep small to stay in linear region. Large signals cause clipping (distortion) at supply rails."
    },
    {
      "group": "Bias",
      "label": "Collector Resistor Rc",
      "param": "rc.resistance",
      "min": 500,
      "max": 10000,
      "default": 3900,
      "step": 100,
      "unit": "Ω",
      "education_note": "Av ≈ -gm × Rc. Increasing Rc raises gain but reduces headroom (Vce gets closer to saturation)."
    },
    {
      "group": "Bias",
      "label": "Load Resistor RL",
      "param": "rl.resistance",
      "min": 1000,
      "max": 100000,
      "default": 10000,
      "step": 500,
      "unit": "Ω",
      "education_note": "With a load, effective gain = -gm × (Rc || RL). A lighter load (higher RL) increases gain."
    },
    {
      "group": "Transistor",
      "label": "β (Current Gain hFE)",
      "param": "q1.dc_params.beta_F",
      "min": 50,
      "max": 500,
      "default": 100,
      "step": 10,
      "unit": "",
      "education_note": "β = Ic/Ib. Higher β means less base current needed for the same collector current."
    }
  ],
  "educational_sequence": [
    {
      "step": 1,
      "title": "DC Operating Point",
      "instruction": "Note the DC voltages: Vb ≈ 2.14V, Ve ≈ 1.49V, Vce ≈ 6.05V. This is the Q-point — the transistor's idle state.",
      "focus_objects": ["q1", "r1", "r2"],
      "focus_controls": []
    },
    {
      "step": 2,
      "title": "Phase Inversion",
      "instruction": "Observe the output waveform. It is 180° out of phase with the input — the hallmark of common-emitter.",
      "focus_objects": ["vin", "cout", "rl"],
      "focus_controls": ["vin.ac_amplitude"]
    },
    {
      "step": 3,
      "title": "Voltage Gain",
      "instruction": "The voltage gain Av ≈ -gm × (Rc || RL) ≈ -37. Increase Rc and watch the gain and Q-point shift.",
      "focus_objects": ["rc", "q1"],
      "focus_controls": ["rc.resistance"]
    },
    {
      "step": 4,
      "title": "Frequency Response",
      "instruction": "Raise input frequency above 10kHz. Watch how gain drops as Cπ and Cμ short the signal path.",
      "focus_objects": ["q1", "cin", "cout"],
      "focus_controls": ["vin.ac_frequency"]
    }
  ]
}
