{
  "simulation_id": "common-emitter-bjt-001",
  "title": "Common Emitter BJT Amplifier",
  "description": "A classic NPN BJT in common-emitter configuration with a voltage divider bias network. Shows signal amplification, phase inversion, and the role of coupling/bypass capacitors.",
  "physics_concept": "BJT Amplification, Small Signal Model, Voltage Gain, Phase Inversion",
  "mode": 2,
  "difficulty": "advanced",
  "tags": ["bjt", "amplifier", "common-emitter", "transistor", "electronics", "ac-analysis"],
  "is_qualitative": false,
  "environment": {
    "gravity_y": 0.0,
    "background": "black",
    "ambient_light": 0.6,
    "show_axes": false,
    "show_grid": true,
    "camera_position": { "x": 0, "y": 0, "z": 22 },
    "fog_enabled": false
  },
  "objects": [
