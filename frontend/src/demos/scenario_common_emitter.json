      "color": "#f97316",
      "type": "resistor",
      "resistance": 47000.0,
      "tolerance_percent": 5.0,
      "temperature_coeff": 100.0,
      "max_power_watts": 0.25,
      "is_nonlinear": false,
      "nonlinear_vi_curve": null,
      "orientation_deg": 90.0,
      "show_power_dissipation": true,
