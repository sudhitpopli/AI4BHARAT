      "show_voltage_label": true,
      "show_current_label": false,
      "parasitics": { "parasitic_L_nH": 0.0, "parasitic_C_pF": 0.0, "model": "ideal" }
    },
    {
      "id": "rc",
      "label": "Rc — Collector Resistor (3.9kΩ)",
      "education_note": "The collector load. Output voltage Vout = Vcc - Ic×Rc. Larger Rc → higher gain but reduced headroom.",
      "position": { "x": 0, "y": 5, "z": 0 },
      "color": "#a855f7",
